/* ---------- speech (Foreign + Vocalized Arabic TTS) ---------- */
const Speech={voices:[],uri:'',rate:1,playing:false,paused:false,idx:0,loop:null,timer:null,sid:0,
init(){if(!('speechSynthesis' in window))return;const l=()=>{const v=speechSynthesis.getVoices()||[];if(v.length){this.voices=v;this.fill(S.lang)}};l();speechSynthesis.onvoiceschanged=l;setTimeout(l,600)},
rank(v,p){const n=v.name.toLowerCase();if(!v.lang.toLowerCase().replace('_','-').startsWith(p))return -1;let s=10;if(n.includes('google'))s+=45;if(/natural|neural|online/.test(n))s+=35;if(/premium|enhanced/.test(n))s+=30;if(/aria|denise|henri|samantha|thomas|am[ée]lie|hamed|salma|tarik|zira|maged|laila/.test(n))s+=25;return s},
ranked(l){const p=l==='ar'?'ar':l==='fr'?'fr':'en';return this.voices.map(v=>[v,this.rank(v,p)]).filter(x=>x[1]>0).sort((a,b)=>b[1]-a[1]).map(x=>x[0])},
fill(l){const s=$('voiceSel');if(!s)return;const r=this.ranked(l);s.replaceChildren();if(!r.length){s.add(new Option(`الصوت الافتراضي (${l.toUpperCase()})`,''));this.uri='';return}
 r.forEach(v=>s.add(new Option(`${v.name.replace(/Microsoft |Google |Apple /g,'')} (${v.lang})`,v.voiceURI)));if(!r.some(v=>v.voiceURI===this.uri))this.uri=r[0].voiceURI;s.value=this.uri},
best(l){const r=this.ranked(l);if(l==='ar')return r[0]||null;return r.find(v=>v.voiceURI===this.uri)||r[0]||null},
utter(t,l,rate){const u=new SpeechSynthesisUtterance(t);u.lang=l==='ar'?'ar-SA':l==='fr'?'fr-FR':'en-US';u.rate=rate;const v=this.best(l);if(v)u.voice=v;return u},
setRate(r){this.rate=r;if(this.playing&&!this.paused)this.playFrom(this.idx)},
wave(a){$('wave').classList.toggle('on',a)},
speak(text,lang,rate=1,loop=null){if(!('speechSynthesis' in window)||!text)return;this.stop(false);this.loop=loop;const sid=this.sid;
 const run=()=>{if(sid!==this.sid)return;speechSynthesis.cancel();const u=this.utter(text,lang,rate);u.onstart=()=>this.wave(true);
  u.onend=()=>{if(sid!==this.sid)return;this.wave(false);if(loop)this.timer=setTimeout(run,650)};u.onerror=()=>{if(sid===this.sid)this.wave(false)};speechSynthesis.speak(u)};run()},
speakArabic(text,rate=.92){
  if(!text)return;
  const cleanAr=text.replace(/[()\/\-—«»]/g,' ').replace(/\s+/g,' ').trim();
  if(!cleanAr)return;
  if('speechSynthesis' in window){
    const arVoices=this.ranked('ar');
    if(arVoices.length){this.speak(cleanAr,'ar',rate);return}
  }
  this.stop(false);
  try{
    const a=new Audio(`https://translate.google.com/translate_tts?ie=UTF-8&tl=ar&client=tw-ob&q=${encodeURIComponent(cleanAr.slice(0,200))}`);
    a.playbackRate=rate;a.play().catch(()=>toast('يرجى تفعيل الصوت في المتصفح'));
  }catch{toast('تعذر تشغيل النطق العربي')}
},
playFrom(i=0){if(!('speechSynthesis' in window)||!S.recs.length)return;this.stop(false);this.playing=true;this.paused=false;this.idx=Math.max(0,Math.min(i,S.recs.length-1));this.ui();const sid=this.sid;
 const next=()=>{if(sid!==this.sid||!this.playing||this.paused)return;if(this.idx>=S.recs.length){this.stop();return}
  const r=S.recs[this.idx];renderPage(r.page);hl(r.tokens);r.tokens[0]?.scrollIntoView({behavior:'smooth',block:'center'});
  speechSynthesis.cancel();const u=this.utter(r.text,S.lang,this.rate);u.onstart=()=>this.wave(true);
  const adv=()=>{if(sid!==this.sid||!this.playing||this.paused)return;this.idx++;next()};u.onend=adv;u.onerror=adv;speechSynthesis.speak(u)};next()},
pause(){if(!this.playing)return;this.paused=true;speechSynthesis.cancel();this.wave(false);this.ui()},
resume(){if(this.playing&&this.paused)this.playFrom(this.idx)},
stop(ui=true){this.sid++;clearTimeout(this.timer);this.loop=null;this.playing=false;this.paused=false;if('speechSynthesis' in window)speechSynthesis.cancel();this.wave(false);if(ui){this.ui();repeatUI()}},
ui(){const on=this.playing&&!this.paused;$('playIcon').textContent=on?'pause':'play_arrow';$('playLbl').textContent=on?'إيقاف مؤقت':this.playing?'متابعة الاستماع':'استماع للمستند';$('stopBtn').hidden=!this.playing}};
function toggleDocAudio(){Speech.playing?(Speech.paused?Speech.resume():Speech.pause()):Speech.playFrom(Math.max(0,S.selIdx))}

/* ---------- language ---------- */
function detect(t){if(S.override!=='auto')return S.override;const s=t.slice(0,3000).toLowerCase();
 const fr=(s.match(/[éèêëàâîïôùûüçœæ]|\b(le|la|les|des|une|dans|pour|avec|sur|est|sont|qui|que|pas|plus|cette|nous|vous|mais|ou|donc|aux|ces|mon|ma|mes)\b/g)||[]).length;
 const en=(s.match(/\b(the|and|that|have|for|not|with|you|this|but|his|from|they|which|their|would|about|there|into|could|were|been)\b/g)||[]).length;return fr>en?'fr':'en'}
function setLang(v){S.override=v;S.lang=detect(S.pages.slice(0,5).flatMap(p=>p.blocks.map(b=>b.text)).join(' '));Speech.fill(S.lang);toast(`اللغة المختارة: ${S.lang==='fr'?'الفرنسية (FR)':'الإنجليزية (EN)'}`)}

/* ---------- ingestion ---------- */
const clean=t=>t.replace(/[\u200B-\u200D\uFEFF]/g,'').replace(/\u00A0/g,' ').replace(/[“”]/g,'"').replace(/[‘’]/g,"'").replace(/\s+/g,' ').trim();
const paras=t=>t.split(/\r?\n\s*\r?\n/).map(p=>clean(p.replace(/\r?\n/g,' '))).filter(Boolean).map(p=>({type:'p',text:p}));
function progress(v,t='',p=0){$('prog').hidden=!v;if(!v)return;$('pgText').textContent=t;$('pgPct').textContent=Math.round(p)+'%';$('pgBar').style.width=Math.round(p)+'%'}
const need=x=>{if(!x)throw new Error('lib')};
async function ingest(f){Speech.stop();const n=f.name.toLowerCase();
 try{if(n.endsWith('.pdf')||f.type==='application/pdf')await readPDF(f);else if(n.endsWith('.docx'))await readDOCX(f);else if(f.type.startsWith('image/')||/\.(png|jpe?g|webp|bmp)$/.test(n))await readImage(f);else openDoc(f.name,[{pageNumber:1,blocks:paras(await f.text())}])}
 catch(e){console.error(e);progress(false);toast(e.message==='lib'?'تعذر تحميل مكتبة القراءة، تحقق من الاتصال.':'تعذر استخراج محتوى الملف.')}}
function pdfBlocks(items){
 const sz=items.map(i=>i.fs).sort((a,b)=>a-b),med=sz[sz.length>>1]||12;items.sort((a,b)=>b.y-a.y||a.x-b.x);
 const lines=[];let cur=[items[0]];for(let i=1;i<items.length;i++){const it=items[i];if(Math.abs(it.y-cur[0].y)<=Math.max(4,cur[0].fs*.4))cur.push(it);else{lines.push(cur);cur=[it]}}lines.push(cur);
 const minX=items.reduce((m,i)=>Math.min(m,i.x),Infinity);
 const L=lines.map(l=>{l.sort((a,b)=>a.x-b.x);let t='';l.forEach((it,j)=>{if(j){const p=l[j-1];if(it.x-(p.x+p.w)>it.fs*.2&&!t.endsWith(' ')&&!it.s.startsWith(' '))t+=' '}t+=it.s});
  return{t:clean(t),y:l[0].y,ind:Math.max(0,Math.round(l[0].x-minX)),fs:l.reduce((a,i)=>a+i.fs,0)/l.length}}).filter(l=>l.t);
 const blocks=[];let a=null;
