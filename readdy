    $('fcBackMain').textContent=item.word;
    $('fcBackMain').className='fc-word';
    $('fcBackMain').dir='ltr';
    $('fcBackSub').textContent=item.ipa||'';
  }
}
function fcFlip(){FC.flipped=!FC.flipped;$('fcCard').classList.toggle('flipped',FC.flipped)}
function fcNav(step){
  if(!FC.deck.length)return;
  FC.flipped=false;
  FC.idx=(FC.idx+step+FC.deck.length)%FC.deck.length;
  renderFlashcard();
}
function fcShuffle(){
  for(let i=FC.deck.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[FC.deck[i],FC.deck[j]]=[FC.deck[j],FC.deck[i]]}
  FC.idx=0;FC.flipped=false;renderFlashcard();toast('تم خلط البطاقات عشوائياً');
}
function fcToggleDir(){
  FC.reverse=!FC.reverse;FC.flipped=false;renderFlashcard();
  toast(FC.reverse?'الوجه الأمامي: المعنى العربي':'الوجه الأمامي: الكلمة الأجنبية');
}
function fcSpeakFront(){
  const item=FC.deck[FC.idx];if(!item)return;
  FC.reverse?Speech.speakArabic(vocalizeArabic(item.translation_ar),.9):Speech.speak(item.word,item.lang,.92);
}
function fcSpeakBack(){
  const item=FC.deck[FC.idx];if(!item)return;
  FC.reverse?Speech.speak(item.word,item.lang,.92):Speech.speakArabic(vocalizeArabic(item.translation_ar),.9);
}
function fcMarkKnown(){
  toast('أحسنت! تم اجتياز البطاقة');
  fcNav(1);
}

/* ---------- vocabulary ---------- */
const isBm=w=>S.saved.some(x=>x.word.toLowerCase()===w.toLowerCase());
const saveVocab=()=>store.set(K.vocab,JSON.stringify(S.saved));
function syncBm(){const s=new Set(S.saved.map(w=>w.word.toLowerCase()));document.querySelectorAll('.wt').forEach(x=>x.classList.toggle('bm',s.has(x.dataset.w)))}
function updBm(){if(!S.sel||S.sel.isSentence)return;const b=isBm(S.sel.word);$('bmBtn').classList.toggle('on',b);$('bmIcon').textContent=b?'bookmark_added':'bookmark_add';$('bmIcon').classList.toggle('fill',b)}
function updBadge(){const n=S.saved.length;$('vCount').textContent=n;$('badge').textContent=n;$('badge').hidden=!n}
function afterVocab(){saveVocab();updBm();updBadge();renderVocab();syncBm()}
function toggleBookmark(){if(!S.sel||S.sel.isSentence)return;const i=S.saved.findIndex(w=>w.word.toLowerCase()===S.sel.word.toLowerCase());
 if(i>=0){S.saved.splice(i,1);toast('تمت إزالة الكلمة من المحفوظات')}else{const d=S.sel;S.saved.unshift({word:d.word,lang:d.lang,ipa:d.ipa||'',translation_ar:d.translation_ar,pos_ar:d.pos_ar||'',nature_orig:d.nature_orig||'',nature_ar:d.nature_ar||'',fonction_orig:d.fonction_orig||'',fonction_ar:d.fonction_ar||'',lemma:d.lemma||'',sentence_original:d.sentence_original||'',sentence_ar:d.sentence_ar||''});toast('تم حفظ الكلمة في المفردات والبطاقات')}afterVocab()}
function drawer(o){if(o)closeConjDrawer();$('drawer').classList.toggle('open',!!o);$('drawer').inert=!o;$('bdrop').classList.toggle('open',!!o||!$('conjDrawer').inert);if(o)renderVocab()}
function renderVocab(){const q=$('vsearch').value.trim().toLowerCase(),l=$('vlist'),it=S.saved.filter(x=>x.word.toLowerCase().includes(q)||x.translation_ar.includes(q));
 if(!it.length){l.innerHTML=`<div class="none"><i class="ms" style="font-size:30px;opacity:.5">bookmark_border</i><p>${S.saved.length?'لا توجد نتائج مطابقة':'لا توجد كلمات محفوظة'}</p></div>`;return}
 l.innerHTML=it.map(x=>`<div class="vitem"><div><div dir="ltr" class="vw"><span class="tag">${esc(x.lang)}</span><b>${esc(x.word)}</b></div><p class="ar-vow">${esc(vocalizeArabic(x.translation_ar))}</p><div style="font-size:10px;color:var(--sub);margin-top:2px" dir="ltr">${esc(x.nature_orig||'')} ${x.fonction_orig?'• '+esc(x.fonction_orig):''}</div></div>
  <div style="display:flex;flex:none">
    <button class="ibtn sm" style="border:0;background:none;color:var(--ac)" data-a="say" data-w="${esc(x.word)}" data-l="${esc(x.lang)}" aria-label="نطق أجنبي"><i class="ms">volume_up</i></button>
    <button class="ibtn sm" style="border:0;background:none;color:var(--ok)" data-a="sayar" data-ar="${esc(vocalizeArabic(x.translation_ar))}" aria-label="نطق عربي"><i class="ms">record_voice_over</i></button>
    <button class="ibtn sm" style="border:0;background:none;color:#d93025" data-a="del" data-w="${esc(x.word)}" aria-label="حذف"><i class="ms">delete</i></button>
  </div></div>`).join('')}
$('vlist').addEventListener('click',e=>{const b=e.target.closest('[data-a]');if(!b)return;
 if(b.dataset.a==='say')Speech.speak(b.dataset.w,b.dataset.l);
 else if(b.dataset.a==='sayar')Speech.speakArabic(b.dataset.ar,.9);
 else{S.saved=S.saved.filter(w=>w.word.toLowerCase()!==b.dataset.w.toLowerCase());afterVocab()}});
function exportCSV(){if(!S.saved.length){toast('لا توجد كلمات محفوظة للتصدير');return}
 const q=v=>{v=String(v||'');if(/^[=+\-@\t\r]/.test(v))v="'"+v;return`"${v.replace(/"/g,'""')}"`};
 const rows=S.saved.map(w=>[w.word,w.lemma||w.word,w.lang.toUpperCase(),w.ipa,w.nature_orig||w.pos_ar,w.fonction_orig||'',vocalizeArabic(w.translation_ar)].map(q).join(','));
 const u=URL.createObjectURL(new Blob(['\uFEFF'+['Word,Lemma,Language,IPA,Nature,Fonction,ArabicTranslation',...rows].join('\n')],{type:'text/csv;charset=utf-8;'})),a=document.createElement('a');
 a.href=u;a.download='readdy-vocabulary.csv';document.body.append(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(u),1000);toast('تم تصدير ملف المفردات بنجاح')}
function saveKey(){S.gem=$('gemKey').value.trim();S.gem?store.set(K.gem,S.gem):store.del(K.gem);show('apiModal',0);toast(S.gem?'تم تفعيل مفتاح Gemini AI':'تم اعتماد المحركات المدمجة')}
function clearCache(){S.cache.clear();S.conjCache.clear();store.del(K.cache);toast('تم مسح الذاكرة المؤقتة')}

/* ---------- init ---------- */
function boot(){
  setThemeIcon();
  Speech.init();
  updBadge();
  openWelcome(false);
  Promise.race([document.fonts.load('20px "Material Symbols Outlined"','search'),new Promise(r=>setTimeout(r,3000))]).catch(()=>{}).then(()=>document.documentElement.classList.add('icons'));
  $('fileInput').addEventListener('change',e=>{const f=e.target.files?.[0];if(f){ingest(f);e.target.value=''}});
  $('docTitleInput').addEventListener('input',e=>S.title=e.target.value);
  let dc=0;addEventListener('dragenter',e=>{if(e.dataTransfer?.types?.includes('Files')){dc++;document.body.classList.add('drag')}});
  addEventListener('dragleave',()=>{dc=Math.max(0,dc-1);if(!dc)document.body.classList.remove('drag')});
  addEventListener('dragover',e=>e.preventDefault());
  addEventListener('drop',e=>{e.preventDefault();dc=0;document.body.classList.remove('drag');const f=e.dataTransfer?.files?.[0];if(f)ingest(f)});
  addEventListener('keydown',e=>{
    if(!$('fcModal').hidden){
      if(e.key===' '||e.key==='Enter'){e.preventDefault();fcFlip();return}
      if(e.key==='ArrowLeft'){fcNav(1);return}
      if(e.key==='ArrowRight'){fcNav(-1);return}
    }
    if(e.key!=='Escape')return;let c=false;['welcomeModal','pasteModal','apiModal','fcModal'].forEach(i=>{if(!$(i).hidden){$(i).hidden=true;c=true}});
    if(!$('conjDrawer').inert){closeConjDrawer();c=true}
    if($('drawer').classList.contains('open')){drawer(0);c=true}if(!c&&!$('panel').hidden)closePanel()});
  document.querySelectorAll('.modal').forEach(m=>m.addEventListener('click',e=>{if(e.target===m)m.hidden=true}));
}
if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',boot)}else{boot()}
</script>
