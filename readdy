function buildLocalConjugation(infinitive,lang){
  const v=infinitive.toLowerCase().trim();
  if(lang==='en'){
    const irr={
      be:{pres:['I am','You are','He/She/It is','We are','They are'],past:['I was','You were','He/She/It was','We were','They were'],fut:['I will be','You will be','He/She/It will be','We will be','They will be'],perf:['I have been','You have been','He/She/It has been','We have been','They have been'],cont:['I am being','You are being','He/She/It is being','We are being','They are being']},
      have:{pres:['I have','You have','He/She/It has','We have','They have'],past:['I had','You had','He/She/It had','We had','They had'],fut:['I will have','You will have','He/She/It will have','We will have','They will have'],perf:['I have had','You have had','He/She/It has had','We have had','They have had'],cont:['I am having','You are having','He/She/It is having','We are having','They are having']},
      do:{pres:['I do','You do','He/She/It does','We do','They do'],past:['I did','You did','He/She/It did','We did','They did'],fut:['I will do','You will do','He/She/It will do','We will do','They will do'],perf:['I have done','You have done','He/She/It has done','We have done','They have done'],cont:['I am doing','You are doing','He/She/It is doing','We are doing','They are doing']},
      go:{pres:['I go','You go','He/She/It goes','We go','They go'],past:['I went','You went','He/She/It went','We went','They went'],fut:['I will go','You will go','He/She/It will go','We will go','They will go'],perf:['I have gone','You have gone','He/She/It has gone','We have gone','They have gone'],cont:['I am going','You are going','He/She/It is going','We are going','They are going']}
    };
    if(irr[v]){
      const d=irr[v];
      return[
        {tense_ar:'المُضَارِعُ البَسِيطُ',tense_orig:'Present Simple',rows:d.pres},
        {tense_ar:'المَاضِي البَسِيطُ',tense_orig:'Past Simple',rows:d.past},
        {tense_ar:'المُسْتَقْبَلُ البَسِيطُ',tense_orig:'Future Simple',rows:d.fut},
        {tense_ar:'المُضَارِعُ التَّامُّ',tense_orig:'Present Perfect',rows:d.perf},
        {tense_ar:'المُضَارِعُ المُسْتَمِرُّ',tense_orig:'Present Continuous',rows:d.cont}
      ];
    }
    const s3=v.endsWith('y')&&!/[aeiou]y$/.test(v)?v.slice(0,-1)+'ies':/(s|sh|ch|x|z|o)$/.test(v)?v+'es':v+'s';
    const ed=v.endsWith('e')?v+'d':v.endsWith('y')&&!/[aeiou]y$/.test(v)?v.slice(0,-1)+'ied':v+'ed';
    const ing=v.endsWith('e')&&!v.endsWith('ee')?v.slice(0,-1)+'ing':v+'ing';
    return[
      {tense_ar:'المُضَارِعُ البَسِيطُ',tense_orig:'Present Simple',rows:[`I ${v}`,`You ${v}`,`He / She / It ${s3}`,`We ${v}`,`They ${v}`]},
      {tense_ar:'المَاضِي البَسِيطُ',tense_orig:'Past Simple',rows:[`I ${ed}`,`You ${ed}`,`He / She / It ${ed}`,`We ${ed}`,`They ${ed}`]},
      {tense_ar:'المُسْتَقْبَلُ البَسِيطُ',tense_orig:'Future Simple',rows:[`I will ${v}`,`You will ${v}`,`He / She / It will ${v}`,`We will ${v}`,`They will ${v}`]},
      {tense_ar:'المُضَارِعُ التَّامُّ',tense_orig:'Present Perfect',rows:[`I have ${ed}`,`You have ${ed}`,`He / She / It has ${ed}`,`We have ${ed}`,`They have ${ed}`]},
      {tense_ar:'المُضَارِعُ المُسْتَمِرُّ',tense_orig:'Present Continuous',rows:[`I am ${ing}`,`You are ${ing}`,`He / She / It is ${ing}`,`We are ${ing}`,`They are ${ing}`]}
    ];
  } else {
    const irr={
      être:{pres:['je suis','tu es','il/elle est','nous sommes','vous êtes','ils/elles sont'],imp:['j’étais','tu étais','il/elle était','nous étions','vous étiez','ils/elles étaient'],pc:['j’ai été','tu as été','il/elle a été','nous avons été','vous avez été','ils/elles ont été'],fut:['je serai','tu seras','il/elle sera','nous serons','vous serez','ils/elles seront'],cond:['je serais','tu serais','il/elle serait','nous serions','vous seriez','ils/elles seraient'],subj:['que je sois','que tu sois','qu’il/elle soit','que nous soyons','que vous soyez','qu’ils/elles soient']},
      avoir:{pres:['j’ai','tu as','il/elle a','nous avons','vous avez','ils/elles ont'],imp:['j’avais','tu avais','il/elle avait','nous avions','vous aviez','ils/elles avaient'],pc:['j’ai eu','tu as eu','il/elle a eu','nous avons eu','vous avez eu','ils/elles ont eu'],fut:['j’aurai','tu auras','il/elle aura','nous aurons','vous aurez','ils/elles auront'],cond:['j’aurais','tu aurais','il/elle aurait','nous aurions','vous auriez','ils/elles auraient'],subj:['que j’aie','que tu aies','qu’il/elle ait','que nous ayons','que vous ayez','qu’ils/elles aient']},
      aller:{pres:['je vais','tu vas','il/elle va','nous allons','vous allez','ils/elles vont'],imp:['j’allais','tu allais','il/elle allait','nous allions','vous alliez','ils/elles allaient'],pc:['je suis allé(e)','tu es allé(e)','il/elle est allé(e)','nous sommes allé(e)s','vous êtes allé(e)s','ils/elles sont allé(e)s'],fut:['j’irai','tu iras','il/elle ira','nous irons','vous irez','ils/elles iront'],cond:['j’irais','tu irais','il/elle irait','nous irions','vous iriez','ils/elles iraient'],subj:['que j’aille','que tu ailles','qu’il/elle aille','que nous allions','que vous alliez','qu’ils/elles aillent']},
      faire:{pres:['je fais','tu fais','il/elle fait','nous faisons','vous faites','ils/elles font'],imp:['je faisais','tu faisais','il/elle faisait','nous faisions','vous faisiez','ils/elles faisaient'],pc:['j’ai fait','tu as fait','il/elle a fait','nous avons fait','vous avez fait','ils/elles ont fait'],fut:['je ferai','tu feras','il/elle fera','nous ferons','vous ferez','ils/elles feront'],cond:['je ferais','tu ferais','il/elle ferait','nous ferions','vous feriez','ils/elles feraient'],subj:['que je fasse','que tu fasses','qu’il/elle fasse','que nous fassions','que vous fassiez','qu’ils/elles fassent']}
    };
    if(irr[v]){
      const d=irr[v];
      return[
        {tense_ar:'الحَاضِرُ (المُضَارِعُ)',tense_orig:'Présent',rows:d.pres},
        {tense_ar:'المَاضِي المُرَكَّبُ',tense_orig:'Passé composé',rows:d.pc},
        {tense_ar:'المَاضِي النَّاقِصُ',tense_orig:'Imparfait',rows:d.imp},
        {tense_ar:'المُسْتَقْبَلُ البَسِيطُ',tense_orig:'Futur simple',rows:d.fut},
        {tense_ar:'الشَّرْطِيُّ الحَاضِرُ',tense_orig:'Conditionnel présent',rows:d.cond},
        {tense_ar:'المَنْصُوبُ الحَاضِرُ',tense_orig:'Subjonctif présent',rows:d.subj}
      ];
    }
    const stem=v.endsWith('er')?v.slice(0,-2):v.endsWith('ir')?v.slice(0,-2):v.endsWith('re')?v.slice(0,-2):v;
    const isIr=v.endsWith('ir')&&!v.endsWith('oir');
    const pres=isIr?[`je ${stem}is`,`tu ${stem}is`,`il/elle ${stem}it`,`nous ${stem}issons`,`vous ${stem}issez`,`ils/elles ${stem}issent`]:[`je ${stem}e`,`tu ${stem}es`,`il/elle ${stem}e`,`nous ${stem}ons`,`vous ${stem}ez`,`ils/elles ${stem}ent`];
    const imp=isIr?[`je ${stem}issais`,`tu ${stem}issais`,`il/elle ${stem}issait`,`nous ${stem}issions`,`vous ${stem}issiez`,`ils/elles ${stem}issaient`]:[`je ${stem}ais`,`tu ${stem}ais`,`il/elle ${stem}ait`,`nous ${stem}ions`,`vous ${stem}iez`,`ils/elles ${stem}aient`];
    const pp=v.endsWith('er')?stem+'é':isIr?stem+'i':stem+'u';
    const futBase=v.endsWith('re')?v.slice(0,-1):v;
    return[
      {tense_ar:'الحَاضِرُ (المُضَارِعُ)',tense_orig:'Présent',rows:pres},
      {tense_ar:'المَاضِي المُرَكَّبُ',tense_orig:'Passé composé',rows:[`j’ai ${pp}`,`tu as ${pp}`,`il/elle a ${pp}`,`nous avons ${pp}`,`vous avez ${pp}`,`ils/elles ont ${pp}`]},
      {tense_ar:'المَاضِي النَّاقِصُ',tense_orig:'Imparfait',rows:imp},
      {tense_ar:'المُسْتَقْبَلُ البَسِيطُ',tense_orig:'Futur simple',rows:[`je ${futBase}ai`,`tu ${futBase}as`,`il/elle ${futBase}a`,`nous ${futBase}ons`,`vous ${futBase}ez`,`ils/elles ${futBase}ont`]},
      {tense_ar:'الشَّرْطِيُّ الحَاضِرُ',tense_orig:'Conditionnel présent',rows:[`je ${futBase}ais`,`tu ${futBase}ais`,`il/elle ${futBase}ait`,`nous ${futBase}ions`,`vous ${futBase}iez`,`ils/elles ${futBase}aient`]},
      {tense_ar:'المَنْصُوبُ الحَاضِرُ',tense_orig:'Subjonctif présent',rows:[`que je ${stem}e`,`que tu ${stem}es`,`qu’il/elle ${stem}e`,`que nous ${stem}ions`,`que vous ${stem}iez`,`qu’ils/elles ${stem}ent`]}
    ];
  }
}

async function openConjugationDrawer(){
  if(!S.sel||S.sel.isSentence)return;
  const inf=(S.sel.lemma||guessLemma(S.sel.word,S.sel.lang)).toLowerCase();
  const lang=S.sel.lang;
  $('drawer').classList.remove('open');$('drawer').inert=true;
  $('conjDrawer').classList.add('open');$('conjDrawer').inert=false;
  $('bdrop').classList.add('open');
  $('conjLangTag').textContent=lang.toUpperCase();

  const cacheKey=`${lang}::${inf}`;
  if(S.conjCache.has(cacheKey)){
    renderConjugationData(inf,S.sel.lemma_translation_ar||S.sel.translation_ar,lang,S.conjCache.get(cacheKey));
    return;
  }

  const localTables=buildLocalConjugation(inf,lang);
  renderConjugationData(inf,S.sel.lemma_translation_ar||S.sel.translation_ar,lang,localTables);

  if(S.gem.trim().length>10){
    try{
      const sl=lang==='fr'?'French':'English';
      const d=await jfetch('https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent',12000,{
        method:'POST',
        headers:{'Content-Type':'application/json','x-goog-api-key':S.gem.trim()},
        body:JSON.stringify({
          contents:[{parts:[{text:`Conjugate the ${sl} verb "${inf}" across all major tenses (Present, Past/Passé composé, Imparfait, Future, Conditional, Subjunctive/Perfect). Return JSON array of objects with keys: tense_ar (with Arabic diacritics), tense_orig, rows (array of strings with pronouns).`}]}],
          generationConfig:{
            responseMimeType:'application/json',
            responseSchema:{
              type:'ARRAY',
              items:{
                type:'OBJECT',
                properties:{
                  tense_ar:{type:'STRING'},
                  tense_orig:{type:'STRING'},
                  rows:{type:'ARRAY',items:{type:'STRING'}}
                },
                required:['tense_ar','tense_orig','rows']
              }
            }
          }
        })
      });
      const aiTables=JSON.parse(d.candidates[0].content.parts[0].text);
      if(Array.isArray(aiTables)&&aiTables.length){
        S.conjCache.set(cacheKey,aiTables);
        if(!$('conjDrawer').inert)renderConjugationData(inf,S.sel.lemma_translation_ar||S.sel.translation_ar,lang,aiTables);
      }
    }catch{}
  }else{
    S.conjCache.set(cacheKey,localTables);
  }
}

