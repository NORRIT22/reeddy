const hasTashkeel=s=>/[\u064B-\u065F\u0670]/.test(s);
function vocalizeArabic(text){
  if(!text)return'';
  if(hasTashkeel(text))return text;
  return text.split(/(\s+|[،؛؟!."«»()\-—:/])/).map(tok=>{
    if(!/[\u0621-\u064A]/.test(tok))return tok;
    const cleanTok=tok.replace(/[^\u0621-\u064A]/g,'');
    if(AR_DIAC_MAP[cleanTok])return AR_DIAC_MAP[cleanTok];
    let w=tok,prefix='';
    if(w.startsWith('و')&&w.length>3){prefix+='وَ';w=w.slice(1)}
    else if(w.startsWith('ف')&&w.length>3&&!w.startsWith('في')){prefix+='فَ';w=w.slice(1)}
    else if(w.startsWith('ب')&&w.length>3&&!w.startsWith('بي')&&!w.startsWith('بع')){prefix+='بِ';w=w.slice(1)}
    else if(w.startsWith('ل')&&w.length>3&&!w.startsWith('لا')&&!w.startsWith('لم')&&!w.startsWith('لن')){prefix+='لِ';w=w.slice(1)}
    if(AR_DIAC_MAP[w])return prefix+AR_DIAC_MAP[w];
    if(w.startsWith('ال')&&w.length>4){
      const stem=w.slice(2);
      const sun=/^[تثدذرزسشصضطظلن]/.test(stem);
      const vStem=AR_DIAC_MAP[stem]?AR_DIAC_MAP[stem].replace(/[\u064B\u064C\u064D]$/,'\u064F'):morphVocalize(stem,true);
      return prefix+(sun?'ال'+vStem[0]+'ّ'+vStem.slice(1):'الْ'+vStem);
    }
    return prefix+morphVocalize(w,false);
  }).join('');
}
function morphVocalize(w,definite){
  if(w.length<=2)return w;
  if(/^مُ?سْتَ/.test(w)&&w.length>=6)return'مُسْتَ'+w.slice(3);
  if(w.startsWith('تَ')||(/^ت[\u0621-\u064A]{2}ي[\u0621-\u064A]$/.test(w)))return'تَ'+w[1]+'ْ'+w[2]+'ِي'+w[4]+(definite?'ُ':'ٌ');
  if(/^م[\u0621-\u064A]{2}و[\u0621-\u064A]$/.test(w))return'مَ'+w[1]+'ْ'+w[2]+'ُو'+w[4]+(definite?'ُ':'ٌ');
  if(/^[\u0621-\u064A]ا[\u0621-\u064A]{2}$/.test(w))return w[0]+'َا'+w[2]+'ِ'+w[3]+(definite?'ُ':'ٌ');
  if(w.endsWith('ة')&&w.length>=4)return w.slice(0,-1)+'َة'+(definite?'ُ':'ٌ');
  if(w.endsWith('ات')&&w.length>=5)return w.slice(0,-2)+'َات'+(definite?'ُ':'ٌ');
  if(w.endsWith('ون')&&w.length>=5)return w.slice(0,-2)+'ُونَ';
  if(w.endsWith('ين')&&w.length>=5)return w.slice(0,-2)+'ِينَ';
  if(w.startsWith('ي')&&w.length===4)return'يَ'+w[1]+'ْ'+w[2]+'ُ'+w[3]+'ُ';
  if(w.startsWith('ت')&&w.length===4)return'تَ'+w[1]+'ْ'+w[2]+'ُ'+w[3]+'ُ';
  return w;
}
async function fetchVocalizedArabic(text){
  if(!text||hasTashkeel(text))return text;
  try{
    const d=await jfetch(`https://tahseel.app/api/diacritize?text=${encodeURIComponent(text.slice(0,500))}`,2200);
    if(d&&d.result&&hasTashkeel(d.result))return d.result;
  }catch{}
  return vocalizeArabic(text);
}

