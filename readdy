/* ---------- Contextual Nature & Fonction Analyzer (Heuristic + Grammar Rules) ---------- */
function analyzeNatureAndFonction(word,sent,lang,posAr){
  const wClean=word.replace(/^['’-]+|['’-]+$/g,'');
  const low=wClean.toLowerCase();
  const hit=LEX[lang]&&LEX[lang][low];
  if(hit&&hit.nature_orig&&hit.fonction_orig){
    return{
      nature_orig:hit.nature_orig,
      nature_ar:hit.nature_ar,
      fonction_orig:hit.fonction_orig,
      fonction_ar:hit.fonction_ar
    };
  }

  // Tokenize sentence to inspect neighboring words for syntactic role (Fonction)
  const tokens=(sent.match(/[\p{L}\p{N}'’-]+/gu)||[]);
  const idx=tokens.findIndex(t=>t.toLowerCase()===low);
  const prev=idx>0?tokens[idx-1].toLowerCase():'';
  const next=idx>=0&&idx<tokens.length-1?tokens[idx+1].toLowerCase():'';

  const isCap=/^[A-ZÀ-Ý]/.test(wClean)&&idx>0;
  const isVerbHint=/فِعْل/.test(posAr);
  const isAdjHint=/صِفَة/.test(posAr);
  const isAdvHint=/ظَرْف|حَال/.test(posAr);
  const isNounHint=/اسْم/.test(posAr);

  if(lang==='fr'){
    const frDets=new Set(['le','la','les','un','une','des','du','au','aux','ce','cet','cette','ces','mon','ma','mes','ton','ta','tes','son','sa','ses','notre','nos','votre','vos','leur','leurs']);
    const frPreps=new Set(['de','du','des','à','au','aux','dans','sur','sous','avec','sans','pour','par','chez','vers','entre','contre','depuis','pendant']);
    const frSubjProns=new Set(['je','tu','il','elle','on','nous','vous','ils','elles','qui']);
    const frAux=new Set(['suis','es','est','sommes','êtes','sont','étais','était','étions','étiez','étaient','ai','as','a','avons','avez','ont','avais','avait']);

    let natOrig='Nom commun',natAr='اسْمٌ عَامٌّ (Nom commun)';
    let fnOrig='Noyau du groupe nominal',fnAr='نَوَاةُ المُرَكَّبِ الِاسْمِيِّ';

    if(isCap){
      natOrig='Nom propre';natAr='اسْمُ عَلَمٍ (Nom propre)';
    }else if(isVerbHint||frSubjProns.has(prev)||frAux.has(prev)||/(er|ir|oir|re|ais|ait|aient|ons|ez|ent|é|ée|és|ées)$/.test(low)&&!frDets.has(prev)){
      natOrig='Verbe conjugué ou à l’infinitif';natAr='فِعْلٌ (Verbe)';
      fnOrig='Noyau verbal de la proposition (Prédicat)';fnAr='رُكْنُ الجُمْلَةِ الفِعْلِيَّةِ (فِعْلٌ مُسْنَدٌ)';
      return{nature_orig:natOrig,nature_ar:natAr,fonction_orig:fnOrig,fonction_ar:fnAr};
    }else if(isAdvHint||/(ment)$/.test(low)){
      natOrig='Adverbe';natAr='ظَرْفٌ / حَالٌ (Adverbe)';
      fnOrig='Modifie le sens du verbe, de l’adjectif ou de la phrase';fnAr='ظَرْفٌ يُقَيِّدُ مَعْنَى الفِعْلِ أَوِ الصِّفَةِ';
      return{nature_orig:natOrig,nature_ar:natAr,fonction_orig:fnOrig,fonction_ar:fnAr};
    }else if(isAdjHint||/(eux|euse|ique|able|ible|if|ive|al|ale|aux)$/.test(low)){
      natOrig='Adjectif qualificatif';natAr='صِفَةٌ / نَعْتٌ (Adjectif)';
      fnOrig=frAux.has(prev)?'Attribut du sujet':'Épithète du nom';
      fnAr=frAux.has(prev)?'خَبَرٌ لِلْمُبْتَدَأِ (Attribut du sujet)':'نَعْتٌ تَابِعٌ لِلِاسْمِ (Épithète)';
      return{nature_orig:natOrig,nature_ar:natAr,fonction_orig:fnOrig,fonction_ar:fnAr};
    }

    // Determine syntactic function (Fonction) for nouns
    if(idx===0||(idx===1&&frDets.has(prev))){
      fnOrig='Sujet du verbe (en tête de phrase)';fnAr='فَاعِلٌ أَوْ مُبْتَدَأٌ فِي صَدْرِ الجُمْلَةِ (Sujet)';
    }else if(prev==='de'||prev==='du'||prev==='des'){
      fnOrig='Complément du nom (introduit par « de »)';fnAr='مُضَافٌ إِلَيْهِ مَجْرُورٌ (Complément du nom)';
    }else if(frPreps.has(prev)){
      fnOrig='Complément circonstanciel ou COI (introduit par préposition)';fnAr='مَفْعُولٌ غَيْرُ مُبَاشِرٍ أَوْ ظَرْفٌ (COI / CC)';
    }else if(frAux.has(prev)||(idx>=2&&frDets.has(prev)&&frAux.has(tokens[idx-2]?.toLowerCase()))){
      fnOrig='Attribut du sujet';fnAr='خَبَرُ فِعْلِ الكَيْنُونَةِ (Attribut du sujet)';
    }else if(frDets.has(prev)){
      fnOrig='Complément d’objet direct (COD) du verbe';fnAr='مَفْعُولٌ بِهِ مُبَاشِرٌ (COD)';
    }
    return{nature_orig:natOrig,nature_ar:natAr,fonction_orig:fnOrig,fonction_ar:fnAr};
  } else {
    // English Nature & Fonction
    const enDets=new Set(['the','a','an','this','that','these','those','my','your','his','her','its','our','their','some','any','each','every']);
    const enPreps=new Set(['in','on','at','to','from','with','by','for','of','about','into','through','during','before','after','under','over','between']);
    const enSubjProns=new Set(['i','you','he','she','it','we','they','who','which','that']);
    const enAux=new Set(['am','is','are','was','were','be','been','being','have','has','had','do','does','did','will','would','can','could','shall','should','may','might','must']);

    let natOrig='Common Noun',natAr='اسْمٌ عَامٌّ (Common Noun)';
    let fnOrig='Head of Noun Phrase',fnAr='نَوَاةُ المُرَكَّبِ الِاسْمِيِّ';

    if(isCap){
      natOrig='Proper Noun';natAr='اسْمُ عَلَمٍ (Proper Noun)';
    }else if(isVerbHint||enSubjProns.has(prev)||enAux.has(prev)||prev==='to'||/(ing|ed)$/.test(low)&&!enDets.has(prev)){
      natOrig='Verb (Finite or Non-finite)';natAr='فِعْلٌ (Verb)';
      fnOrig='Main Predicate / Verb Phrase Head';fnAr='المُسْنَدُ الفِعْلِيُّ فِي الجُمْلَةِ (Predicate)';
      return{nature_orig:natOrig,nature_ar:natAr,fonction_orig:fnOrig,fonction_ar:fnAr};
    }else if(isAdvHint||low.endsWith('ly')){
      natOrig='Adverb';natAr='ظَرْفٌ / حَالٌ (Adverb)';
      fnOrig='Adverbial Modifier (modifies verb/adjective)';fnAr='ظَرْفٌ مُقَيِّدٌ لِلْفِعْلِ أَوِ الصِّفَةِ';
      return{nature_orig:natOrig,nature_ar:natAr,fonction_orig:fnOrig,fonction_ar:fnAr};
    }else if(isAdjHint||/(ous|ful|less|able|ible|ive|ic|al|ent|ant)$/.test(low)){
      natOrig='Adjective';natAr='صِفَةٌ / نَعْتٌ (Adjective)';
      fnOrig=enAux.has(prev)?'Subject Complement (Predicative)':'Attributive Modifier of Noun';
      fnAr=enAux.has(prev)?'خَبَرٌ مُكَمِّلٌ لِلْفَاعِلِ (Subject Complement)':'نَعْتٌ سَابِقٌ لِلِاسْمِ (Attributive Modifier)';
      return{nature_orig:natOrig,nature_ar:natAr,fonction_orig:fnOrig,fonction_ar:fnAr};
    }

    if(idx===0||(idx===1&&enDets.has(prev))){
      fnOrig='Subject of the Clause';fnAr='فَاعِلٌ أَوْ مُبْتَدَأُ الجُمْلَةِ (Subject)';
    }else if(enPreps.has(prev)||(idx>=2&&enDets.has(prev)&&enPreps.has(tokens[idx-2]?.toLowerCase()))){
      fnOrig='Object of Preposition (Adverbial / Genitive)';fnAr='اسْمٌ مَجْرُورٌ بِحَرْفِ الجَرِّ (Object of Preposition)';
    }else if(enAux.has(prev)||(idx>=2&&enDets.has(prev)&&enAux.has(tokens[idx-2]?.toLowerCase()))){
      fnOrig='Subject Complement (Predicate Nominative)';fnAr='خَبَرُ فِعْلِ الكَيْنُونَةِ (Subject Complement)';
    }else if(enDets.has(prev)){
      fnOrig='Direct Object of the Verb';fnAr='مَفْعُولٌ بِهِ مُبَاشِرٌ (Direct Object)';
    }
    return{nature_orig:natOrig,nature_ar:natAr,fonction_orig:fnOrig,fonction_ar:fnAr};
  }
}

